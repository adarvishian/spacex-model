{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && VITE_DEPLOY_SHA=$VERCEL_GIT_COMMIT_SHA npm run build",
  "outputDirectory": "static/ui",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
